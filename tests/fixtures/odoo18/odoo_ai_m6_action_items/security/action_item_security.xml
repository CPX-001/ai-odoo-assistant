<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="rule_m6_action_item_owner" model="ir.rule">
        <field name="name">M6 action items: own records only</field>
        <field name="model_id" ref="model_odoo_ai_m6_action_item"/>
        <field name="domain_force">[('owner_id', '=', user.id), ('company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[(4, ref('base.group_user'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>
</odoo>
