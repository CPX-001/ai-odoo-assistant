{
  "protocol_version": 1,
  "allowed_peer_uids": [1001],
  "socket_gid": 1001,
  "systemctl_path": "/usr/bin/systemctl",
  "systemd_run_path": "/usr/bin/systemd-run",
  "config_targets": {
    "odoo": {
      "path": "/etc/odoo/odoo.conf",
      "allowed_keys": [
        "workers",
        "limit_time_cpu",
        "limit_time_real"
      ],
      "max_bytes": 262144
    }
  },
  "service_targets": {
    "odoo-test": {
      "unit": "odoo-test.service",
      "timeout_seconds": 60
    }
  },
  "module_targets": {
    "assistant": {
      "module": "odoo_ai_assistant",
      "database": "odoo",
      "odoo_python": "/opt/odoo/venv/bin/python3",
      "odoo_bin": "/opt/odoo/odoo-bin",
      "config_path": "/etc/odoo/odoo.conf",
      "addons_path": [
        "/opt/odoo/addons",
        "/opt/odoo/custom/addons"
      ],
      "run_as_uid": 1001,
      "run_as_gid": 1001,
      "timeout_seconds": 540
    }
  }
}
