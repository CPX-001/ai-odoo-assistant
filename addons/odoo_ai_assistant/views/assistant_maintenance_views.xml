<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_odoo_ai_assistant_diagnostics_maintenance_form" model="ir.ui.view">
        <field name="name">odoo.ai.assistant.diagnostics.maintenance.form</field>
        <field name="model">odoo.ai.assistant.diagnostics</field>
        <field name="inherit_id" ref="view_odoo_ai_assistant_diagnostics_form"/>
        <field name="arch" type="xml">
            <xpath expr="//button[@name='action_rescan_source']" position="attributes">
                <attribute name="name">action_maintenance_source_rescan</attribute>
                <attribute name="string">Rescan Source</attribute>
            </xpath>
            <xpath expr="//button[@name='action_test_source']" position="attributes">
                <attribute name="name">action_maintenance_source_test</attribute>
            </xpath>
            <xpath expr="//button[@name='action_test_logs']" position="attributes">
                <attribute name="name">action_maintenance_logs_test</attribute>
            </xpath>
            <xpath expr="//header" position="inside">
                <button
                    name="action_maintenance_readiness_test"
                    type="object"
                    string="Test Readiness"
                />
                <button
                    name="action_maintenance_knowledge_reindex"
                    type="object"
                    string="Reindex Knowledge"
                />
                <button
                    name="action_maintenance_reasoning_test"
                    type="object"
                    string="Test Codex"
                />
                <button
                    name="action_maintenance_action_self_test"
                    type="object"
                    string="Test ACTION Readiness"
                />
                <button
                    name="action_maintenance_configuration_revalidate"
                    type="object"
                    string="Revalidate Configuration"
                />
            </xpath>
            <xpath expr="//group[@string='Healthy checks']" position="after">
                <group string="Maintenance operations" col="1">
                    <field name="maintenance_last_result" nolabel="1"/>
                    <field
                        name="maintenance_active_jobs"
                        nolabel="1"
                        invisible="not maintenance_active_jobs"
                    />
                    <field
                        name="maintenance_latest"
                        nolabel="1"
                        invisible="not maintenance_latest"
                    />
                </group>
            </xpath>
        </field>
    </record>
</odoo>
