<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_odoo_ai_knowledge_source_list" model="ir.ui.view">
        <field name="name">odoo.ai.knowledge.source.list</field>
        <field name="model">odoo.ai.knowledge.source</field>
        <field name="arch" type="xml">
            <list string="AI Knowledge Sources" default_order="write_date desc">
                <field name="name"/>
                <field name="state" widget="badge"/>
                <field name="access_mode"/>
                <field name="owner_user_id"/>
                <field name="company_id" groups="base.group_multi_company"/>
                <field name="version"/>
                <field name="chunk_count"/>
                <field name="indexed_at"/>
            </list>
        </field>
    </record>

    <record id="view_odoo_ai_knowledge_source_form" model="ir.ui.view">
        <field name="name">odoo.ai.knowledge.source.form</field>
        <field name="model">odoo.ai.knowledge.source</field>
        <field name="arch" type="xml">
            <form string="AI Knowledge Source">
                <header>
                    <button
                        name="action_queue_processing"
                        type="object"
                        string="Queue indexing"
                        class="btn-primary"
                        invisible="state == 'processing'"
                        help="Prepare this document for Assistant search in the background."
                    />
                    <button
                        name="action_process_now"
                        type="object"
                        string="Process now"
                        groups="base.group_system"
                        invisible="state == 'processing'"
                        help="Index this document immediately instead of waiting for the background job."
                    />
                    <button
                        name="action_disable"
                        type="object"
                        string="Disable"
                        invisible="state != 'active'"
                        help="Keep the source but stop the Assistant from using it in answers."
                    />
                    <button
                        name="action_activate"
                        type="object"
                        string="Activate"
                        invisible="state != 'indexed'"
                        help="Make the indexed document available to the Assistant."
                    />
                    <field name="state" widget="statusbar" statusbar_visible="uploaded,processing,indexed,active,error"/>
                </header>
                <sheet>
                    <div class="alert alert-info mb-3" role="status">
                        Upload a PDF or supported text document, choose who may use it, and wait for
                        the status to become Active. Odoo detects the file type and calculates all
                        technical values automatically.
                    </div>
                    <div class="alert alert-warning mb-3" role="alert" invisible="state != 'error'">
                        Odoo could not extract searchable text from this document. Check that the file
                        is readable and not password-protected; scanned PDFs need OCR before upload.
                    </div>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1>
                            <field name="name" placeholder="For example: Customer support handbook"/>
                        </h1>
                        <div class="text-muted">
                            Use a title your team will recognize in Assistant citations.
                        </div>
                    </div>
                    <group>
                        <group string="Document">
                            <field name="filename" invisible="1"/>
                            <field name="data" filename="filename"/>
                        </group>
                        <group string="Availability">
                            <field name="access_mode"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_odoo_ai_knowledge_source" model="ir.actions.act_window">
        <field name="name">AI Knowledge</field>
        <field name="res_model">odoo.ai.knowledge.source</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem
        id="menu_odoo_ai_knowledge_source"
        name="Knowledge"
        parent="menu_odoo_ai_assistant_root"
        action="action_odoo_ai_knowledge_source"
        sequence="10"
        groups="base.group_system"
    />
</odoo>
