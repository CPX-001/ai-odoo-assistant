<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form_odoo_ai_assistant_chat" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.odoo.ai.assistant.chat</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="odoo_ai_assistant.res_config_settings_view_form_odoo_ai_assistant"/>
        <field name="mode">extension</field>
        <field name="active" eval="True"/>
        <field name="arch" type="xml">
            <xpath expr="//block[@name='assistant_general']" position="after">
                <block title="Chat interface">
                    <setting
                        string="Recent chats"
                        help="Limits how many recent conversations are loaded into the Assistant history UI."
                    >
                        <field name="assistant_recent_chat_limit"/>
                        <div class="text-muted">
                            Recommended for modest self-hosted servers: 10–20. Allowed range: 5–50.
                        </div>
                    </setting>
                    <setting
                        string="Assistant autonomy"
                        help="Each user chooses a simple autonomy profile directly in the chat. Odoo access rights and record rules always remain in force."
                    >
                        <div class="text-muted">
                            Available profiles: Strict, Balanced, Autonomous and Full access.
                        </div>
                    </setting>
                </block>
            </xpath>
        </field>
    </record>
</odoo>
