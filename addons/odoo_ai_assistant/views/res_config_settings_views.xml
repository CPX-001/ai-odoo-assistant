<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form_odoo_ai_assistant" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.odoo.ai.assistant</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//form" position="inside">
                <app
                    data-string="AI Assistant"
                    string="AI Assistant"
                    name="odoo_ai_assistant"
                    groups="base.group_system"
                >
                    <block name="assistant_general" title="Assistant policy">
                        <setting string="Maximum autonomy">
                            <field name="assistant_agent_confirmation_mode"/>
                        </setting>
                        <setting string="Maximum automatic risk">
                            <field name="assistant_agent_max_auto_risk"/>
                        </setting>
                        <setting
                            string="Test data"
                            help="Synthetic data is allowed only when the user explicitly requests or authorizes test/demo data."
                        >
                            <field name="assistant_agent_allow_synthetic_data"/>
                        </setting>
                        <setting
                            string="Default response detail"
                            help="Default for users without a personal choice. Concise, Normal and Extensive adapt to the task; none imposes a fixed answer length."
                        >
                            <field name="assistant_default_response_detail"/>
                        </setting>
                    </block>
                    <block name="assistant_scheduler" title="Assistant scheduler">
                        <setting
                            string="Concurrent Assistant turns"
                            help="Maximum Assistant turns executing at once. With the current two cron runner slots this value can be 1 or 2; additional turns remain queued."
                        >
                            <field name="assistant_concurrent_turns"/>
                        </setting>
                    </block>
                </app>
            </xpath>
        </field>
    </record>

    <record id="action_odoo_ai_assistant_settings" model="ir.actions.act_window">
        <field name="name">AI Assistant Configuration</field>
        <field name="path">ai-assistant-settings</field>
        <field name="res_model">res.config.settings</field>
        <field name="view_mode">form</field>
        <field name="target">inline</field>
        <field name="context">{'module': 'odoo_ai_assistant', 'bin_size': False}</field>
    </record>

    <menuitem
        id="menu_odoo_ai_assistant_settings"
        name="Configuration"
        parent="menu_odoo_ai_assistant_root"
        action="action_odoo_ai_assistant_settings"
        sequence="90"
        groups="base.group_system"
    />
</odoo>
