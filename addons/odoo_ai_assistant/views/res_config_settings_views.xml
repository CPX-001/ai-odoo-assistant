<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form_odoo_ai_assistant" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.odoo.ai.assistant</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//form" position="inside">
                <app
                    data-string="AI Assistant"
                    string="AI Assistant"
                    name="odoo_ai_assistant"
                    groups="base.group_system"
                >
                    <block title="Local Assistant connection">
                        <setting
                            string="Service URL"
                            help="Only HTTP loopback endpoints are accepted."
                        >
                            <div class="content-group">
                                <field name="assistant_service_url" placeholder="http://127.0.0.1:8079"/>
                                <div class="text-muted">
                                    Effective:
                                    <field name="assistant_service_url_effective" class="oe_inline"/>
                                    (<field name="assistant_service_url_origin" class="oe_inline"/>)
                                </div>
                            </div>
                        </setting>
                        <setting
                            string="Machine authentication"
                            help="The credential and its filesystem reference remain host-owned."
                        >
                            <field name="assistant_machine_credential_configured"/>
                        </setting>
                    </block>

                    <block title="Source scanner">
                        <setting
                            string="Source roots"
                            help="Requested roots must remain inside the setup-authorized envelope."
                        >
                            <field name="assistant_source_roots" placeholder="/srv/odoo/custom-addons"/>
                        </setting>
                        <setting string="Authorized envelope" help="Read-only host boundary.">
                            <field name="assistant_source_authorized_roots"/>
                        </setting>
                    </block>

                    <block title="Logs">
                        <setting
                            string="Log provider"
                            help="Selection is limited to providers already authorized by setup."
                        >
                            <field name="assistant_log_provider"/>
                            <div class="text-muted">
                                Available:
                                <field name="assistant_log_provider_options" class="oe_inline"/>
                            </div>
                        </setting>
                    </block>

                    <block title="Knowledge">
                        <setting
                            string="Knowledge provider"
                            help="M5 uses the provisioned Assistant PostgreSQL index; no arbitrary knowledge path is exposed here."
                        >
                            <field name="assistant_knowledge_provider"/>
                        </setting>
                    </block>

                    <block title="Reasoning runtime">
                        <setting string="Model">
                            <field name="assistant_reasoning_model"/>
                        </setting>
                        <setting string="Startup timeout">
                            <field name="assistant_reasoning_startup_timeout_seconds"/>
                        </setting>
                        <setting string="Turn timeout">
                            <field name="assistant_reasoning_turn_timeout_seconds"/>
                        </setting>
                    </block>

                    <block title="Effective configuration">
                        <setting string="Revision">
                            <field name="assistant_config_revision"/>
                            <field name="assistant_config_fingerprint"/>
                        </setting>
                        <setting string="Validation and apply state">
                            <field name="assistant_config_validation_state"/>
                            <field name="assistant_config_post_action"/>
                        </setting>
                        <setting string="Effective values and provenance">
                            <field name="assistant_config_effective_summary"/>
                        </setting>
                        <setting
                            string="Host-owned boundaries"
                            help="Read-only status; Settings cannot change these values."
                        >
                            <field name="assistant_host_only_summary"/>
                        </setting>
                    </block>
                </app>
            </xpath>
        </field>
    </record>
</odoo>
