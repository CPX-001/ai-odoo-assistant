<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form_odoo_ai_assistant" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.odoo.ai.assistant</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//form" position="inside">
                <app
                    data-string="AI Assistant"
                    string="AI Assistant"
                    name="odoo_ai_assistant"
                    groups="base.group_system"
                >
                    <block name="assistant_general" title="Assistant policy">
                        <setting string="Maximum autonomy">
                            <field name="assistant_agent_confirmation_mode"/>
                        </setting>
                        <setting string="Maximum automatic risk">
                            <field name="assistant_agent_max_auto_risk"/>
                        </setting>
                        <setting
                            string="Test data"
                            help="Synthetic data is allowed only when the user explicitly requests or authorizes test/demo data."
                        >
                            <field name="assistant_agent_allow_synthetic_data"/>
                        </setting>
                    </block>
                    <block name="assistant_scheduler" title="Assistant scheduler">
                        <setting
                            string="Concurrent Assistant turns"
                            help="Maximum Assistant turns executing at once. With the current two cron runner slots this value can be 1 or 2; additional turns remain queued."
                        >
                            <field name="assistant_concurrent_turns"/>
                        </setting>
                    </block>
                </app>
            </xpath>
        </field>
    </record>
</odoo>
