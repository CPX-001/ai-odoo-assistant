<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_odoo_ai_assistant_diagnostics_form" model="ir.ui.view">
        <field name="name">odoo.ai.assistant.diagnostics.form</field>
        <field name="model">odoo.ai.assistant.diagnostics</field>
        <field name="arch" type="xml">
            <form string="AI Assistant Diagnostics" create="0" delete="0">
                <header>
                    <button name="action_refresh" type="object" string="Refresh Diagnostics" class="btn-primary"/>
                    <button name="action_open_settings" type="object" string="Open Settings"/>
                    <button name="action_rescan_source" type="object" string="Reanalyze Source"/>
                    <button name="action_test_source" type="object" string="Test Source"/>
                    <button name="action_test_logs" type="object" string="Test Logs"/>
                </header>
                <sheet>
                    <group string="Structured Diagnostic Matrix">
                        <field name="readiness"/>
                        <field name="diagnostics_checked_at"/>
                        <field name="diagnostics_config_revision"/>
                    </group>
                    <group string="Errors" col="1" invisible="not diagnostic_errors">
                        <field name="diagnostic_errors" nolabel="1"/>
                    </group>
                    <group string="Warnings / pending" col="1" invisible="not diagnostic_warnings">
                        <field name="diagnostic_warnings" nolabel="1"/>
                    </group>
                    <group string="Healthy checks" col="1" invisible="not diagnostic_ok">
                        <field name="diagnostic_ok" nolabel="1"/>
                    </group>
                    <group string="Embedded Codex account">
                        <field name="codex_account_state"/>
                        <field name="codex_account_identity" invisible="not codex_account_identity"/>
                        <field name="codex_account_plan" invisible="not codex_account_plan"/>
                        <field name="codex_account_detail"/>
                        <field name="codex_account_usage" nolabel="1" invisible="not codex_account_usage"/>
                    </group>
                    <separator string="Legacy Detail / Evidence"/>
                    <group string="Local Assistant Service">
                        <field name="service_state" widget="badge"/>
                        <field name="message"/>
                        <field name="endpoint_state"/>
                    </group>
                    <group string="Readiness detail">
                        <field name="assistant_database_state"/>
                        <field name="migrations_state"/>
                    </group>
                    <group string="Detected Instance Facts">
                        <field name="instance_id"/>
                        <field name="instance_fingerprint"/>
                    </group>
                    <group string="Source">
                        <field name="source_state"/>
                        <field name="source_scan_status"/>
                        <field name="source_scan_fingerprint"/>
                    </group>
                    <group string="Logs">
                        <field name="log_state"/>
                        <field name="log_provider"/>
                    </group>
                    <group string="Reasoning Engine">
                        <field name="reasoning_engine_state"/>
                        <field name="reasoning_provider"/>
                        <field name="reasoning_protocol"/>
                        <field name="reasoning_runtime_version"/>
                        <field name="reasoning_model"/>
                        <field name="reasoning_setup_message"/>
                    </group>
                    <group string="Bounded Diagnostic Evidence" col="1">
                        <field name="source_result" nolabel="1"/>
                        <field name="log_result" nolabel="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_odoo_ai_assistant_diagnostics" model="ir.actions.act_window">
        <field name="name">AI Assistant Diagnostics</field>
        <field name="res_model">odoo.ai.assistant.diagnostics</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="view_odoo_ai_assistant_diagnostics_form"/>
        <field name="target">current</field>
    </record>

    <menuitem
        id="menu_odoo_ai_assistant_diagnostics"
        name="AI Assistant"
        parent="base.menu_administration"
        action="action_odoo_ai_assistant_diagnostics"
        sequence="95"
        groups="base.group_system"
    />
</odoo>
