<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_odoo_ai_assistant_diagnostics_form" model="ir.ui.view">
        <field name="name">odoo.ai.assistant.diagnostics.form</field>
        <field name="model">odoo.ai.assistant.diagnostics</field>
        <field name="arch" type="xml">
            <form string="AI Assistant Diagnostics" create="0" delete="0">
                <header>
                    <button name="action_refresh" type="object" string="Test Service" class="btn-primary"/>
                </header>
                <sheet>
                    <group string="Local Assistant Service">
                        <field name="service_state" widget="badge"/>
                        <field name="message"/>
                        <field name="endpoint_state"/>
                    </group>
                    <group string="Readiness">
                        <field name="readiness"/>
                        <field name="assistant_database_state"/>
                        <field name="migrations_state"/>
                    </group>
                    <group string="Detected Instance Facts">
                        <field name="instance_id"/>
                        <field name="instance_fingerprint"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_odoo_ai_assistant_diagnostics" model="ir.actions.act_window">
        <field name="name">AI Assistant Diagnostics</field>
        <field name="res_model">odoo.ai.assistant.diagnostics</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="view_odoo_ai_assistant_diagnostics_form"/>
        <field name="target">current</field>
    </record>

    <menuitem
        id="menu_odoo_ai_assistant_diagnostics"
        name="AI Assistant"
        parent="base.menu_administration"
        action="action_odoo_ai_assistant_diagnostics"
        sequence="95"
        groups="base.group_system"
    />
</odoo>
