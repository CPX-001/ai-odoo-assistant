<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="odoo_ai_assistant.AssistantPanelAutonomyPicker"
        t-inherit="odoo_ai_assistant.AssistantPanel" t-inherit-mode="extension">
        <xpath expr="//form[contains(@class, 'o_ai_assistant_composer')]//button[@type='submit']" position="before">
            <div class="o_ai_assistant_autonomy_picker">
                <Dropdown position="'top-end'" menuClass="'o_ai_assistant_picker_menu'"
                    disabled="state.autonomyLoading or state.autonomySaving or state.loading">
                    <button type="button" class="o_ai_assistant_picker_button"
                        aria-label="Nivel de autonomía del Assistant"
                        t-att-title="'Autonomía: ' + autonomyProfileLabel">
                    <i t-if="state.autonomyLoading or state.autonomySaving"
                        class="fa fa-spinner fa-spin" aria-hidden="true"/>
                    <i t-else="" t-att-class="'fa ' + autonomyProfileIconClass"
                        aria-hidden="true"/>
                    <span class="o_ai_assistant_picker_label" t-esc="autonomyProfileLabel"/>
                    </button>
                    <t t-set-slot="content">
                    <div class="o_ai_assistant_picker_menu_title small text-muted">
                        ¿Cuándo debe pedir aprobación?
                    </div>
                    <DropdownItem class="'o_ai_assistant_picker_option'"
                        onSelected="() => this.selectAutonomyProfile('strict')">
                        <span class="o_ai_assistant_picker_option_icon"><i class="fa fa-hand-paper-o" aria-hidden="true"/></span>
                        <span class="min-w-0 flex-grow-1">
                            <span class="d-block fw-semibold">Estricto</span>
                            <span class="d-block small text-muted">Pide confirmación antes de cualquier cambio.</span>
                        </span>
                        <i t-if="state.autonomyProfile === 'strict'" class="fa fa-check" aria-hidden="true"/>
                    </DropdownItem>
                    <DropdownItem class="'o_ai_assistant_picker_option'"
                        onSelected="() => this.selectAutonomyProfile('balanced')">
                        <span class="o_ai_assistant_picker_option_icon"><i class="fa fa-balance-scale" aria-hidden="true"/></span>
                        <span class="min-w-0 flex-grow-1">
                            <span class="d-block fw-semibold">Equilibrado</span>
                            <span class="d-block small text-muted">Trabaja solo; confirma operaciones de riesgo alto.</span>
                        </span>
                        <i t-if="state.autonomyProfile === 'balanced'" class="fa fa-check" aria-hidden="true"/>
                    </DropdownItem>
                    <DropdownItem class="'o_ai_assistant_picker_option'"
                        onSelected="() => this.selectAutonomyProfile('autonomous')">
                        <span class="o_ai_assistant_picker_option_icon"><i class="fa fa-bolt" aria-hidden="true"/></span>
                        <span class="min-w-0 flex-grow-1">
                            <span class="d-block fw-semibold">Autónomo</span>
                            <span class="d-block small text-muted">Sólo detiene operaciones protegidas o irreversibles.</span>
                        </span>
                        <i t-if="state.autonomyProfile === 'autonomous'" class="fa fa-check" aria-hidden="true"/>
                    </DropdownItem>
                    <DropdownItem class="'o_ai_assistant_picker_option o_ai_assistant_picker_option_divided'"
                        onSelected="() => this.selectAutonomyProfile('full_access')">
                        <span class="o_ai_assistant_picker_option_icon"><i class="fa fa-unlock-alt" aria-hidden="true"/></span>
                        <span class="min-w-0 flex-grow-1">
                            <span class="d-block fw-semibold">Acceso completo</span>
                            <span class="d-block small text-muted">Sin confirmaciones adicionales del Assistant. Se mantienen los permisos de Odoo.</span>
                        </span>
                        <i t-if="state.autonomyProfile === 'full_access'" class="fa fa-check" aria-hidden="true"/>
                    </DropdownItem>
                    </t>
                </Dropdown>
            </div>
        </xpath>
    </t>
</templates>
