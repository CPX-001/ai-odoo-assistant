<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="odoo_ai_assistant.AssistantPanelPublicActivity"
       t-inherit="odoo_ai_assistant.AssistantPanel"
       t-inherit-mode="extension">
        <xpath expr="//div[@t-if='state.loading and state.streamingText']" position="before">
            <section t-if="activityItems.length"
                class="o_ai_assistant_activity mt-3 border rounded bg-light-subtle px-2 py-2"
                aria-label="Actividad del Assistant">
                <details>
                    <summary class="small d-flex align-items-center gap-2">
                        <i t-if="state.loading" class="fa fa-circle-o-notch fa-spin" aria-hidden="true"/>
                        <i t-else="" class="fa fa-check-circle-o" aria-hidden="true"/>
                        <span class="text-break" t-esc="activitySummaryLabel"/>
                    </summary>
                    <div class="mt-2 d-flex flex-column gap-1">
                        <div t-foreach="activityItems" t-as="item" t-key="item.key"
                            class="small text-muted d-flex gap-2 align-items-start">
                            <i t-if="item.status === 'running'" class="fa fa-circle-o-notch fa-spin mt-1" aria-hidden="true"/>
                            <i t-elif="item.status === 'failed'" class="fa fa-exclamation-circle mt-1" aria-hidden="true"/>
                            <i t-else="" class="fa fa-check mt-1" aria-hidden="true"/>
                            <span class="text-break flex-grow-1">
                                <t t-esc="item.label"/>
                                <t t-if="item.resource and item.resource.model">
                                    <span class="ms-1">· <t t-esc="item.resource.model"/></span>
                                </t>
                            </span>
                        </div>
                    </div>
                </details>
            </section>
        </xpath>
        <xpath expr="//div[@t-if='state.loading and !state.streamingText']" position="attributes">
            <attribute name="t-if">state.loading and !state.streamingText and !activityItems.length</attribute>
        </xpath>
    </t>
</templates>
