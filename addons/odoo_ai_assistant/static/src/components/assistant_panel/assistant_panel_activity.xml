<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="odoo_ai_assistant.AssistantPanelPublicActivity"
       t-inherit="odoo_ai_assistant.AssistantPanel"
       t-inherit-mode="extension">
        <xpath expr="//div[@t-if='state.loading and state.streamingText']" position="before">
            <section t-if="activityItems.length"
                class="o_ai_assistant_activity mt-3 border rounded bg-light-subtle px-2 py-2"
                aria-label="Assistant activity">
                <details>
                    <summary class="small d-flex align-items-center gap-2">
                        <i t-if="state.loading" class="fa fa-circle-o-notch fa-spin" aria-hidden="true"/>
                        <i t-else="" class="fa fa-check-circle-o" aria-hidden="true"/>
                        <span class="text-break" t-esc="activitySummaryLabel"/>
                    </summary>
                    <div class="mt-2 d-flex flex-column gap-1">
                        <div t-if="activityReasoningSummaryParts.length"
                            class="small border-start ps-2 mb-1">
                            <div class="fw-semibold text-body-secondary mb-1"
                                t-esc="activityReasoningSummaryTitle"/>
                            <div t-foreach="activityReasoningSummaryParts" t-as="part" t-key="part.key"
                                class="text-muted text-break" t-esc="part.text"/>
                        </div>
                        <div t-foreach="activityItems" t-as="item" t-key="item.key"
                            class="small text-muted">
                            <div class="d-flex gap-2 align-items-start">
                                <i t-if="item.status === 'running'" class="fa fa-circle-o-notch fa-spin mt-1" aria-hidden="true"/>
                                <i t-elif="item.status === 'failed'" class="fa fa-exclamation-circle mt-1" aria-hidden="true"/>
                                <i t-elif="item.status === 'blocked'" class="fa fa-pause-circle-o mt-1" aria-hidden="true"/>
                                <i t-elif="item.status === 'cancelled'" class="fa fa-ban mt-1" aria-hidden="true"/>
                                <i t-else="" class="fa fa-check mt-1" aria-hidden="true"/>
                                <span class="text-break flex-grow-1" t-esc="item.display_label"/>
                                <small t-if="item.duration_label" class="text-nowrap" t-esc="item.duration_label"/>
                            </div>
                            <div t-if="item.progress_label" class="ms-4 mt-1 small text-body-secondary"
                                t-esc="item.progress_label"/>
                            <div t-if="item.result_summary_label" class="ms-4 mt-1 small text-body-secondary"
                                t-esc="item.result_summary_label"/>
                            <div t-if="item.references.length" class="ms-4 mt-1 d-flex flex-wrap gap-1">
                                <button t-foreach="item.references" t-as="reference"
                                    t-key="activityReferenceKey(reference)"
                                    type="button"
                                    class="btn btn-sm btn-outline-secondary rounded-pill py-0 px-2 text-start"
                                    t-att-title="reference.description || reference.label"
                                    t-att-aria-label="reference.label"
                                    t-on-click="() => this.openActivityReference(reference)">
                                    <i class="fa fa-external-link me-1" aria-hidden="true"/>
                                    <t t-esc="reference.label"/>
                                </button>
                                <div t-if="item.reference_remaining_count"
                                    class="d-flex flex-wrap gap-2 align-items-center w-100">
                                    <button t-if="item.can_show_more_references" type="button"
                                        class="btn btn-link btn-sm p-0"
                                        t-on-click="() => this.showMoreActivityReferences(item)">
                                        <t t-esc="activityShowMoreLabel(item)"/>
                                    </button>
                                    <button t-if="item.can_show_remaining_references and item.reference_remaining_count > item.reference_next_count"
                                        type="button" class="btn btn-link btn-sm p-0"
                                        t-on-click="() => this.showRemainingActivityReferences(item)">
                                        <t t-esc="activityShowRemainingLabel(item)"/>
                                    </button>
                                </div>
                            </div>
                            <div t-if="item.references_over_limit" class="ms-4 mt-1 small text-muted">
                                Not all records are shown at once to avoid overloading the browser.
                            </div>
                            <button t-if="item.model_reference" type="button"
                                class="btn btn-link btn-sm p-0 ms-4 mt-1"
                                t-on-click="() => this.openActivityReference(item.model_reference)">
                                <i class="fa fa-list me-1" aria-hidden="true"/>
                                Open in Odoo
                            </button>
                        </div>
                        <div t-if="semanticActivity.truncated" class="small text-muted fst-italic">
                            Older steps have been hidden to keep the panel responsive.
                        </div>
                    </div>
                </details>
            </section>
        </xpath>
        <xpath expr="//div[@t-if='state.loading and !state.streamingText']" position="attributes">
            <attribute name="t-if">state.loading and !state.streamingText and !activityItems.length</attribute>
        </xpath>
    </t>
</templates>
