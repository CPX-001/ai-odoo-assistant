<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="odoo_ai_assistant.AssistantPanelPublicActivity"
       t-inherit="odoo_ai_assistant.AssistantPanel"
       t-inherit-mode="extension">
        <xpath expr="//div[@t-foreach='state.messages']" position="attributes">
            <attribute name="t-foreach">activityOrderedMessages</attribute>
        </xpath>
        <xpath expr="//div[@t-if='state.loading and state.streamingText']" position="before">
            <section t-if="activityItems.length"
                t-att-class="'o_ai_assistant_activity mt-3 ' + (state.loading ? 'o_ai_assistant_activity_running' : 'o_ai_assistant_activity_settled')"
                aria-label="Assistant activity">
                <details>
                    <summary class="small d-flex align-items-center gap-2">
                        <i t-if="state.loading" class="fa fa-circle-o-notch fa-spin" aria-hidden="true"/>
                        <i t-else="" class="fa fa-check-circle-o" aria-hidden="true"/>
                        <span t-att-class="'text-break ' + (state.loading ? 'o_ai_assistant_activity_shimmer' : '')"
                            t-esc="activitySummaryLabel"/>
                    </summary>
                    <div class="o_ai_assistant_activity_details mt-2 d-flex flex-column gap-1">
                        <div t-if="activityReasoningSummaryParts.length"
                            class="o_ai_assistant_reasoning_summary small mb-1">
                            <div t-foreach="activityReasoningSummaryParts" t-as="part" t-key="part.key"
                                class="text-muted text-break" t-esc="part.text"/>
                        </div>
                        <div t-foreach="activityItems" t-as="item" t-key="item.key"
                            class="small text-muted">
                            <div class="d-flex gap-2 align-items-start">
                                <i t-if="item.status === 'running'" class="fa fa-circle-o-notch fa-spin mt-1" aria-hidden="true"/>
                                <i t-elif="item.status === 'failed'" class="fa fa-exclamation-circle mt-1" aria-hidden="true"/>
                                <i t-elif="item.status === 'blocked'" class="fa fa-pause-circle-o mt-1" aria-hidden="true"/>
                                <i t-elif="item.status === 'cancelled'" class="fa fa-ban mt-1" aria-hidden="true"/>
                                <i t-else="" class="fa fa-check mt-1" aria-hidden="true"/>
                                <span class="text-break flex-grow-1" t-esc="item.display_label"/>
                                <small t-if="item.duration_label" class="text-nowrap" t-esc="item.duration_label"/>
                            </div>
                            <div t-if="item.progress_label" class="ms-4 mt-1 small text-body-secondary"
                                t-esc="item.progress_label"/>
                            <div t-if="item.result_summary_label" class="ms-4 mt-1 small text-body-secondary"
                                t-esc="item.result_summary_label"/>
                        </div>
                        <div t-if="semanticActivity.truncated" class="small text-muted fst-italic">
                            Older steps have been hidden to keep the panel responsive.
                        </div>
                    </div>
                </details>
            </section>
            <div t-if="settledActivityAnswer"
                class="o_ai_assistant_message o_ai_assistant_message_assistant mt-3">
                <div class="small text-muted mb-1">Assistant</div>
                <div class="o_ai_assistant_message_content text-break" t-esc="settledActivityAnswer"/>
            </div>
        </xpath>
        <xpath expr="//div[@t-if='state.loading and !state.streamingText']" position="attributes">
            <attribute name="t-if">state.loading and !state.streamingText and !activityItems.length</attribute>
        </xpath>
    </t>
</templates>