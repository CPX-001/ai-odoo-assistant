<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="odoo_ai_assistant.AssistantPanelPublicActivity"
       t-inherit="odoo_ai_assistant.AssistantPanel"
       t-inherit-mode="extension">
        <xpath expr="//div[@t-if='state.loading and state.streamingText']" position="before">
            <section t-if="state.currentActivity"
                class="o_ai_assistant_activity mt-3 border rounded bg-light-subtle px-2 py-2"
                aria-label="Actividad del Assistant">
                <details>
                    <summary class="small d-flex align-items-center gap-2">
                        <i class="fa fa-circle-o-notch" aria-hidden="true"/>
                        <span class="text-break" t-esc="state.currentActivity.label"/>
                    </summary>
                    <div class="mt-2 d-flex flex-column gap-1">
                        <div t-foreach="state.activityEvents" t-as="event" t-key="event.sequence"
                            class="small text-muted d-flex gap-2 align-items-start">
                            <span class="font-monospace" t-esc="event.sequence"/>
                            <span class="text-break flex-grow-1">
                                <t t-esc="event.label"/>
                                <t t-if="event.resource and event.resource.model">
                                    <span class="ms-1">· <t t-esc="event.resource.model"/></span>
                                </t>
                            </span>
                        </div>
                    </div>
                </details>
            </section>
        </xpath>
        <xpath expr="//div[@t-if='state.loading and !state.streamingText']" position="attributes">
            <attribute name="t-if">state.loading and !state.streamingText and !state.currentActivity</attribute>
        </xpath>
    </t>
</templates>
