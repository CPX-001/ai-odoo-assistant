<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="odoo_ai_assistant.AssistantSystray">
        <div class="o_ai_assistant_systray d-flex">
            <button type="button" class="o_nav_entry border-0 px-3" title="AI Assistant"
                aria-label="Abrir AI Assistant" t-att-aria-expanded="state.isOpen ? 'true' : 'false'"
                t-on-click="togglePanel">
                <span class="o_ai_assistant_systray_icon" aria-hidden="true"/>
            </button>
        </div>
    </t>

    <t t-name="odoo_ai_assistant.AssistantPanel">
        <aside t-if="state.isOpen" t-ref="panel"
            t-att-class="panelClass" t-att-style="panelStyle"
            aria-label="AI Assistant">
            <header class="o_ai_assistant_header border-bottom px-3 py-2">
                <div class="o_ai_assistant_drag_handle d-flex align-items-center justify-content-between gap-2"
                    t-on-pointerdown="startDrag" t-on-pointermove="dragPanel"
                    t-on-pointerup="endDrag" t-on-pointercancel="endDrag">
                    <div class="min-w-0">
                        <h2 class="h5 mb-0">AI Assistant</h2>
                        <small class="text-muted text-truncate d-block" t-esc="contextLabel"/>
                    </div>
                    <div class="d-flex gap-1">
                        <button type="button" class="btn btn-sm btn-outline-secondary"
                            title="Nuevo chat" aria-label="Nuevo chat"
                            t-att-disabled="recoveryPending" t-on-click="newConversation">
                            <i class="fa fa-plus" aria-hidden="true"/>
                        </button>
                        <button type="button" class="btn btn-sm btn-link text-body"
                            aria-label="Cerrar AI Assistant" title="Cerrar" t-on-click="closePanel">
                            <i class="fa fa-times" aria-hidden="true"/>
                        </button>
                    </div>
                </div>
                <div t-if="!ui.isMinimized" class="mt-2">
                    <select class="form-select form-select-sm" aria-label="Historial de chats"
                        t-att-disabled="state.loading or state.historyLoading or state.decisionLoading or recoveryPending"
                        t-on-change="selectConversation">
                        <option value="" t-att-selected="!state.conversationId">Nuevo chat</option>
                        <option t-foreach="state.conversations" t-as="conversation"
                            t-key="conversation.conversation_id"
                            t-att-value="conversation.conversation_id"
                            t-att-selected="conversation.conversation_id === state.conversationId"
                            t-esc="conversation.title"/>
                    </select>
                </div>
            </header>

            <div t-if="!ui.isMinimized"
                class="o_ai_assistant_messages flex-grow-1 overflow-auto p-3" aria-live="polite">
                <div t-if="state.historyLoading and !state.messages.length"
                    class="text-center text-muted py-5">
                    <i class="fa fa-spinner fa-spin me-1" aria-hidden="true"/> Cargando historial…
                </div>

                <div t-if="!state.historyLoading and !state.messages.length"
                    class="o_ai_assistant_empty text-center px-3 py-5">
                    <i class="fa fa-magic fa-2x mb-3 text-muted" aria-hidden="true"/>
                    <h3 class="h6">¿Qué necesitas hacer?</h3>
                    <p class="small text-muted mb-0">
                        Pregunta por datos de Odoo, configuración, código, módulos o pide una operación.
                    </p>
                </div>

                <div class="d-flex flex-column gap-3">
                    <div t-foreach="state.messages" t-as="message" t-key="message.message_id"
                        t-att-class="'o_ai_assistant_message ' + (message.role === 'user' ? 'o_ai_assistant_message_user' : 'o_ai_assistant_message_assistant')">
                        <div class="small text-muted mb-1">
                            <t t-if="message.role === 'user'">Tú</t>
                            <t t-else="">Assistant</t>
                        </div>
                        <div class="o_ai_assistant_message_content text-break" t-esc="message.content"/>
                    </div>
                </div>

                <div t-if="state.loading" class="o_ai_assistant_message o_ai_assistant_message_assistant mt-3">
                    <div class="small text-muted mb-1">Assistant</div>
                    <div><i class="fa fa-spinner fa-spin me-1" aria-hidden="true"/> Pensando…</div>
                </div>

                <div t-if="state.errorCode"
                    class="o_ai_assistant_message o_ai_assistant_message_assistant mt-3"
                    role="status">
                    <div class="small text-muted mb-1">Assistant</div>
                    <div class="o_ai_assistant_message_content o_ai_assistant_failure_message text-break"
                        t-esc="errorMessage"/>
                </div>

                <section t-if="state.result and state.result.plan and state.result.plan.state === 'awaiting_confirmation' and !state.actionReceipt"
                    class="o_ai_assistant_confirmation mt-3" role="status">
                    <div class="d-flex gap-2 align-items-start">
                        <span class="o_ai_assistant_confirmation_icon d-inline-flex align-items-center justify-content-center">
                            <i class="fa fa-shield" aria-hidden="true"/>
                        </span>
                        <div class="min-w-0 flex-grow-1">
                            <div class="fw-semibold mb-1">Confirmar acción</div>
                            <div class="small text-muted">
                                <t t-if="state.result.plan.risk === 'protected'">
                                    Esta operación puede ser irreversible o afectar datos importantes.
                                </t>
                                <t t-else="">
                                    Tu nivel de autonomía actual pide aprobación antes de ejecutar esta operación.
                                </t>
                            </div>
                        </div>
                    </div>
                    <div class="d-flex gap-2 mt-3">
                        <button type="button" class="btn btn-primary flex-grow-1"
                            t-att-disabled="state.decisionLoading" t-on-click="approveAction">
                            <i t-if="state.decisionLoading" class="fa fa-spinner fa-spin me-1"
                                aria-hidden="true"/> Continuar
                        </button>
                        <button type="button" class="btn btn-outline-secondary"
                            t-att-disabled="state.decisionLoading" t-on-click="rejectAction">
                            Cancelar
                        </button>
                    </div>
                </section>

                <section t-if="recoveryPending" class="alert alert-warning mt-3 mb-0" role="status">
                    <div class="fw-semibold mb-1">
                        <t t-if="recoveryExecuting">Ejecución en curso</t>
                        <t t-else="">Recuperación pendiente</t>
                    </div>
                    <div class="small mb-2">
                        <t t-if="recoveryExecuting">
                            El plan sigue ejecutándose. No se volverá a lanzar: sólo se consultará su estado hasta que Odoo confirme el resultado o habilite una recuperación segura.
                        </t>
                        <t t-else="">
                            El resultado del lote quedó ambiguo. Se conservarán la misma autorización y el mismo intento para recuperar el resultado sin duplicar cambios.
                        </t>
                    </div>
                    <button type="button" class="btn btn-warning btn-sm"
                        t-att-disabled="state.decisionLoading" t-on-click="retryAction">
                        <i t-if="state.decisionLoading" class="fa fa-spinner fa-spin me-1"
                            aria-hidden="true"/>
                        <t t-if="recoveryExecuting">Comprobar estado</t>
                        <t t-else="">Reintentar recuperación</t>
                    </button>
                </section>

                <div t-if="state.actionReceipt and !recoveryPending"
                    t-att-class="'alert mt-3 ' + actionDecisionClass"
                    role="status" t-esc="actionDecisionMessage"/>
            </div>

            <form t-if="!ui.isMinimized"
                class="o_ai_assistant_composer border-top p-3" t-on-submit.prevent="submit">
                <div class="o_ai_assistant_composer_row d-flex align-items-end gap-2">
                    <textarea id="o_ai_assistant_question" class="form-control flex-grow-1"
                        rows="2" maxlength="4000"
                        placeholder="Pregunta o pide una operación en Odoo…"
                        t-att-value="state.draft"
                        t-on-input="onDraftInput"
                        t-on-keydown="onComposerKeydown"
                        t-att-disabled="state.loading or state.decisionLoading or recoveryPending"/>
                    <button type="submit" class="btn btn-primary o_ai_assistant_send_button"
                        aria-label="Enviar mensaje" title="Enviar mensaje"
                        t-att-disabled="state.loading or state.decisionLoading or recoveryPending or !state.draft.trim()">
                        <i t-if="state.loading" class="fa fa-spinner fa-spin" aria-hidden="true"/>
                        <i t-else="" class="fa fa-paper-plane" aria-hidden="true"/>
                    </button>
                </div>
            </form>
        </aside>
    </t>
</templates>
