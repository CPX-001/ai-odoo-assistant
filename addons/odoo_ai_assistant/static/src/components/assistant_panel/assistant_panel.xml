<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="odoo_ai_assistant.AssistantSystray">
        <div class="o_ai_assistant_systray d-flex">
            <button type="button" class="o_nav_entry border-0 px-3" title="AI Assistant"
                aria-label="Abrir AI Assistant" t-att-aria-expanded="state.isOpen ? 'true' : 'false'"
                t-on-click="togglePanel">
                <span class="o_ai_assistant_systray_icon" aria-hidden="true"/>
            </button>
        </div>
    </t>

    <t t-name="odoo_ai_assistant.AssistantPanel">
        <aside t-if="state.isOpen" t-ref="panel"
            t-att-class="panelClass" t-att-style="panelStyle"
            aria-label="AI Assistant">
            <header class="o_ai_assistant_header border-bottom px-3 py-2">
                <div class="o_ai_assistant_drag_handle d-flex align-items-center justify-content-between gap-2"
                    t-on-pointerdown="startDrag" t-on-pointermove="dragPanel"
                    t-on-pointerup="endDrag" t-on-pointercancel="endDrag">
                    <div class="min-w-0">
                        <h2 class="h5 mb-0">AI Assistant</h2>
                        <small class="text-muted text-truncate d-block" t-esc="contextLabel"/>
                    </div>
                    <div class="d-flex gap-1 align-items-center">
                        <button t-if="state.runtimeState === 'authenticated'" type="button"
                            class="btn btn-sm btn-outline-secondary"
                            title="Nuevo chat" aria-label="Nuevo chat"
                            t-att-disabled="recoveryPending" t-on-click="newConversation">
                            <i class="fa fa-plus" aria-hidden="true"/>
                        </button>

                        <div t-if="state.runtimeState === 'authenticated'" class="position-relative">
                            <button type="button" class="btn btn-sm btn-link text-body"
                                title="Cuenta de ChatGPT" aria-label="Cuenta de ChatGPT"
                                t-on-click="toggleRuntimeAccountMenu">
                                <i class="fa fa-user-circle" aria-hidden="true"/>
                            </button>
                            <div t-if="ui.accountOpen"
                                class="dropdown-menu show position-absolute end-0 mt-1 p-3 shadow"
                                style="min-width: 18rem; z-index: 1080;"
                                t-on-pointerdown="stopRuntimeMenuPointerDown">
                                <div class="fw-semibold mb-1">ChatGPT conectado</div>
                                <t t-if="state.runtimeCanConfigure and state.runtimeAccount">
                                    <div t-if="state.runtimeAccount.email"
                                        class="small text-muted text-break"
                                        t-esc="state.runtimeAccount.email"/>
                                    <div t-if="state.runtimeAccount.plan_type"
                                        class="small text-muted">
                                        Plan: <t t-esc="state.runtimeAccount.plan_type"/>
                                    </div>
                                    <div t-if="state.runtimeAccount.auth_mode"
                                        class="small text-muted">
                                        Auth: <t t-esc="state.runtimeAccount.auth_mode"/>
                                    </div>

                                    <div class="dropdown-divider"/>
                                    <div class="small fw-semibold mb-1">Uso de Codex</div>
                                    <div t-if="state.runtimeAccount.rate_limits.length"
                                        class="d-flex flex-column gap-1">
                                        <div t-foreach="state.runtimeAccount.rate_limits"
                                            t-as="limit" t-key="limit_index"
                                            class="small text-muted"
                                            t-esc="runtimeUsageLabel(limit)"/>
                                    </div>
                                    <div t-else="" class="small text-muted">
                                        Codex no ha devuelto límites de uso.
                                    </div>

                                    <div class="dropdown-divider"/>
                                    <button type="button"
                                        class="btn btn-sm btn-outline-secondary w-100 mb-2"
                                        t-on-click="openRuntimeSettings">
                                        Configuración del Assistant
                                    </button>
                                </t>
                                <t t-else="">
                                    <div class="small text-muted">
                                        La cuenta de ChatGPT la gestiona un administrador de Odoo.
                                    </div>
                                </t>
                            </div>
                        </div>

                        <button type="button" class="btn btn-sm btn-link text-body"
                            aria-label="Cerrar AI Assistant" title="Cerrar" t-on-click="closePanel">
                            <i class="fa fa-times" aria-hidden="true"/>
                        </button>
                    </div>
                </div>

                <div t-if="!ui.isMinimized and state.runtimeState === 'authenticated'" class="mt-2">
                    <select class="form-select form-select-sm" aria-label="Historial de chats"
                        t-att-disabled="state.loading or state.historyLoading or state.decisionLoading or recoveryPending"
                        t-on-change="selectConversation">
                        <option value="" t-att-selected="!state.conversationId">Nuevo chat</option>
                        <option t-foreach="state.conversations" t-as="conversation"
                            t-key="conversation.conversation_id"
                            t-att-value="conversation.conversation_id"
                            t-att-selected="conversation.conversation_id === state.conversationId"
                            t-esc="conversation.title"/>
                    </select>
                </div>
            </header>

            <div t-if="!ui.isMinimized"
                class="o_ai_assistant_messages flex-grow-1 overflow-auto p-3" aria-live="polite">
                <t t-if="state.runtimeState !== 'authenticated'">
                    <div class="h-100 d-flex align-items-center justify-content-center py-4">
                        <div class="text-center w-100 px-3" style="max-width: 24rem;">
                            <div t-if="state.runtimeLoading or state.runtimeState === null"
                                class="text-muted py-5" role="status">
                                <i class="fa fa-spinner fa-spin fa-2x mb-3" aria-hidden="true"/>
                                <div>Comprobando la conexión con ChatGPT…</div>
                            </div>

                            <t t-else="">
                                <i class="fa fa-link fa-2x mb-3 text-muted" aria-hidden="true"/>
                                <h3 class="h5 mb-2">Sesión principal de Codex no disponible</h3>
                                <p class="small text-muted mb-3" t-esc="runtimeSetupMessage"/>

                                <t t-if="state.runtimeCanConfigure">
                                    <div class="d-flex flex-column gap-2">
                                        <button type="button" class="btn btn-primary"
                                            t-on-click="openRuntimeSettings">
                                            Configurar Codex
                                        </button>
                                        <button type="button"
                                            class="btn btn-outline-primary"
                                            t-att-disabled="state.runtimeActionLoading"
                                            t-on-click="refreshRuntimeAccount">
                                            Reintentar
                                        </button>
                                    </div>
                                </t>
                                <div t-else="" class="alert alert-light border small mb-0">
                                    La sesión principal de Codex la gestiona el host de Odoo.
                                </div>
                            </t>
                        </div>
                    </div>
                </t>

                <t t-else="">
                    <div t-if="state.historyLoading and !state.messages.length"
                        class="text-center text-muted py-5">
                        <i class="fa fa-spinner fa-spin me-1" aria-hidden="true"/> Cargando historial…
                    </div>

                    <div t-if="!state.historyLoading and !state.messages.length"
                        class="o_ai_assistant_empty text-center px-3 py-5">
                        <i class="fa fa-magic fa-2x mb-3 text-muted" aria-hidden="true"/>
                        <h3 class="h6">¿Qué necesitas hacer?</h3>
                        <p class="small text-muted mb-0">
                            Pregunta por datos de Odoo, configuración, código, módulos o pide una operación.
                        </p>
                    </div>

                    <div class="o_ai_assistant_conversation d-flex flex-column">
                        <div t-foreach="state.messages" t-as="message" t-key="message.message_id"
                            t-att-class="'o_ai_assistant_message ' + (message.role === 'user' ? 'o_ai_assistant_message_user' : 'o_ai_assistant_message_assistant')">
                            <div t-att-class="'o_ai_assistant_message_role small text-muted ' + (message.role === 'user' ? '' : 'visually-hidden')">
                                <t t-if="message.role === 'user'">Tú</t>
                                <t t-else="">Assistant</t>
                            </div>
                            <div class="o_ai_assistant_message_content text-break" t-esc="message.content"/>
                        </div>
                    </div>

                    <div t-if="state.loading and state.streamingText"
                        class="o_ai_assistant_message o_ai_assistant_message_assistant mt-3">
                        <div class="small text-muted mb-1">Assistant</div>
                        <div class="o_ai_assistant_message_content text-break" t-esc="state.streamingText"/>
                    </div>

                    <div t-if="state.loading and !state.streamingText"
                        class="o_ai_assistant_message o_ai_assistant_message_assistant mt-3">
                        <div class="small text-muted mb-1">Assistant</div>
                        <div><i class="fa fa-spinner fa-spin me-1" aria-hidden="true"/> Pensando…</div>
                    </div>

                    <div t-if="state.errorCode"
                        class="o_ai_assistant_message o_ai_assistant_message_assistant mt-3"
                        role="status">
                        <div class="small text-muted mb-1">Assistant</div>
                        <div class="o_ai_assistant_message_content o_ai_assistant_failure_message text-break"
                            t-esc="errorMessage"/>
                    </div>

                    <section t-if="state.result and state.result.plan and state.result.plan.state === 'awaiting_confirmation' and !state.actionReceipt"
                        class="o_ai_assistant_confirmation mt-3" role="status">
                        <div class="d-flex gap-2 align-items-start">
                            <span class="o_ai_assistant_confirmation_icon d-inline-flex align-items-center justify-content-center">
                                <i class="fa fa-shield" aria-hidden="true"/>
                            </span>
                            <div class="min-w-0 flex-grow-1">
                                <div class="fw-semibold mb-1">Confirmar acción</div>
                                <div class="small text-muted">
                                    <t t-if="state.result.plan.risk === 'protected'">
                                        Esta operación puede ser irreversible o afectar datos importantes.
                                    </t>
                                    <t t-else="">
                                        Tu nivel de autonomía actual pide aprobación antes de ejecutar esta operación.
                                    </t>
                                </div>
                            </div>
                        </div>
                        <div class="d-flex flex-column gap-2 mt-3">
                            <div t-foreach="state.result.plan.steps" t-as="step" t-key="step.step_id"
                                class="border rounded p-2 bg-light-subtle">
                                <div class="d-flex align-items-start justify-content-between gap-2">
                                    <div class="fw-semibold small text-break" t-esc="step.title"/>
                                    <span class="badge text-bg-secondary" t-esc="step.risk"/>
                                </div>
                                <div class="small mt-1 text-break" t-esc="step.summary"/>
                                <t t-set="previewRows" t-value="batchPreviewRows(step)"/>
                                <ol t-if="previewRows.length" class="small mt-2 mb-1 ps-3">
                                    <li t-foreach="previewRows" t-as="row" t-key="row.key"
                                        class="text-break">
                                        <span t-esc="row.label"/>
                                        <span t-if="row.excluded" class="text-muted"> — excluido por protección de Odoo</span>
                                    </li>
                                </ol>
                                <button t-if="batchPreviewRemaining(step)" type="button"
                                    class="btn btn-link btn-sm p-0"
                                    t-on-click="() => this.toggleBatchPreview(step)">
                                    Ver <t t-esc="batchPreviewRemaining(step)"/> más
                                </button>
                                <div t-if="batchPreviewOmitted(step)" class="small text-muted mt-1">
                                    Hay <t t-esc="batchPreviewOmitted(step)"/> registro(s) adicional(es) no mostrados en esta vista previa.
                                </div>
                                <div class="small text-muted mt-1 text-break">
                                    <span t-esc="step.capability"/>
                                    <span class="mx-1">·</span>
                                    <span t-esc="step.approval"/>
                                </div>
                            </div>
                        </div>
                        <div class="d-flex gap-2 mt-3">
                            <button type="button" class="btn btn-primary flex-grow-1"
                                t-att-disabled="state.decisionLoading" t-on-click="approveAction">
                                <i t-if="state.decisionLoading" class="fa fa-spinner fa-spin me-1"
                                    aria-hidden="true"/> Continuar
                            </button>
                            <button type="button" class="btn btn-outline-secondary"
                                t-att-disabled="state.decisionLoading" t-on-click="rejectAction">
                                Cancelar
                            </button>
                        </div>
                    </section>

                    <section t-if="executionPending and !recoveryReviewRequired"
                        class="o_ai_assistant_execution_status mt-3" role="status">
                        <div class="fw-semibold mb-1">
                            <t t-if="recoveryExecuting">Ejecutando la acción</t>
                            <t t-else="">Acción aprobada en cola</t>
                        </div>
                        <div class="small text-muted mb-2">
                            <t t-if="recoveryExecuting">
                                Odoo está ejecutando el plan una sola vez y verificará el resultado.
                            </t>
                            <t t-else="">
                                El plan aprobado espera al worker; todavía no implica que se haya escrito ningún dato.
                            </t>
                        </div>
                        <button type="button" class="btn btn-link btn-sm p-0"
                            t-att-disabled="state.decisionLoading" t-on-click="retryAction">
                            <i t-if="state.decisionLoading" class="fa fa-spinner fa-spin me-1"
                                aria-hidden="true"/>
                            Actualizar estado
                        </button>
                    </section>

                    <section t-if="recoveryReviewRequired" class="alert alert-warning mt-3 mb-0" role="status">
                        <div class="fw-semibold mb-1">Revisión de ejecución pendiente</div>
                        <div class="small mb-2">
                            Odoo sí cruzó la barrera de escritura y no puede confirmar el resultado. No se repetirá la acción a ciegas.
                        </div>
                        <button type="button" class="btn btn-warning btn-sm"
                            t-att-disabled="state.decisionLoading" t-on-click="retryAction">
                            <i t-if="state.decisionLoading" class="fa fa-spinner fa-spin me-1"
                                aria-hidden="true"/>
                            Comprobar estado
                        </button>
                    </section>

                    <div t-if="state.actionReceipt and !recoveryPending and state.actionReceipt.state === 'failed'"
                        class="o_ai_assistant_message o_ai_assistant_message_assistant mt-3"
                        role="status">
                        <div class="small text-muted mb-1">Assistant</div>
                        <div class="o_ai_assistant_message_content text-break" t-esc="actionDecisionMessage"/>
                    </div>

                    <div t-if="state.actionReceipt and !recoveryPending and state.actionReceipt.state !== 'failed'"
                        t-att-class="'alert mt-3 ' + actionDecisionClass"
                        role="status" t-esc="actionDecisionMessage"/>
                </t>
            </div>

            <form t-if="!ui.isMinimized and state.runtimeState === 'authenticated'"
                class="o_ai_assistant_composer border-top p-3" t-on-submit.prevent="submit">
                <div class="o_ai_assistant_composer_row d-flex align-items-end gap-2">
                    <textarea id="o_ai_assistant_question" class="form-control flex-grow-1"
                        rows="2" maxlength="4000"
                        placeholder="Pregunta o pide una operación en Odoo…"
                        t-att-value="state.draft"
                        t-on-input="onDraftInput"
                        t-on-keydown="onComposerKeydown"
                        t-att-disabled="state.loading or state.decisionLoading or recoveryPending"/>
                    <button type="submit" class="btn btn-primary o_ai_assistant_send_button"
                        aria-label="Enviar mensaje" title="Enviar mensaje"
                        t-att-disabled="state.loading or state.decisionLoading or recoveryPending or !state.draft.trim()">
                        <i t-if="state.loading" class="fa fa-spinner fa-spin" aria-hidden="true"/>
                        <i t-else="" class="fa fa-paper-plane" aria-hidden="true"/>
                    </button>
                </div>
            </form>
        </aside>
    </t>
</templates>
