<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="odoo_ai_assistant.AssistantPanelPlanningPicker"
        t-inherit="odoo_ai_assistant.AssistantPanel" t-inherit-mode="extension">
        <xpath expr="//form[contains(@class, 'o_ai_assistant_composer')]//button[contains(@class, 'o_ai_assistant_send_button')]" position="before">
            <div class="o_ai_assistant_planning_picker">
                <Dropdown position="'top-end'"
                    menuClass="'o_ai_assistant_picker_menu o_ai_assistant_planning_menu'"
                    disabled="state.planningLoading or state.planningSaving">
                    <button type="button"
                        class="o_ai_assistant_picker_button o_ai_assistant_picker_button_icon"
                        aria-label="Modo de planificación del Assistant"
                        t-att-title="'Planificación: ' + planningModeLabel">
                        <i t-if="state.planningLoading or state.planningSaving"
                            class="fa fa-spinner fa-spin" aria-hidden="true"/>
                        <i t-else="" t-att-class="'fa ' + planningModeIconClass"
                            aria-hidden="true"/>
                        <i class="fa fa-angle-down o_ai_assistant_picker_caret"
                            aria-hidden="true"/>
                    </button>
                    <t t-set-slot="content">
                        <div class="o_ai_assistant_picker_menu_title small text-muted">
                            Profundidad de planificación
                        </div>
                        <DropdownItem class="'o_ai_assistant_picker_option'"
                            onSelected="() => this.selectPlanningMode('adaptive')">
                            <span class="o_ai_assistant_picker_option_icon"><i class="fa fa-random" aria-hidden="true"/></span>
                            <span class="min-w-0 flex-grow-1">
                                <span class="d-block fw-semibold">Adaptativo</span>
                                <span class="d-block small text-muted">Empieza directo y crea un plan visible cuando el trabajo lo necesita.</span>
                            </span>
                            <i t-if="state.planningMode === 'adaptive'" class="fa fa-check" aria-hidden="true"/>
                        </DropdownItem>
                        <DropdownItem class="'o_ai_assistant_picker_option'"
                            onSelected="() => this.selectPlanningMode('deliberate')">
                            <span class="o_ai_assistant_picker_option_icon"><i class="fa fa-list-ol" aria-hidden="true"/></span>
                            <span class="min-w-0 flex-grow-1">
                                <span class="d-block fw-semibold">Plan</span>
                                <span class="d-block small text-muted">Para trabajo profundo, exige un TaskPlan antes de consultar o preparar acciones.</span>
                            </span>
                            <i t-if="state.planningMode === 'deliberate'" class="fa fa-check" aria-hidden="true"/>
                        </DropdownItem>
                        <DropdownItem class="'o_ai_assistant_picker_option o_ai_assistant_picker_option_divided'"
                            onSelected="() => this.selectPlanningMode('auto')">
                            <span class="o_ai_assistant_picker_option_icon"><i class="fa fa-magic" aria-hidden="true"/></span>
                            <span class="min-w-0 flex-grow-1">
                                <span class="d-block fw-semibold">Auto</span>
                                <span class="d-block small text-muted">Odoo elige entre Adaptativo y Plan según señales estructurales de complejidad.</span>
                            </span>
                            <i t-if="state.planningMode === 'auto'" class="fa fa-check" aria-hidden="true"/>
                        </DropdownItem>
                    </t>
                </Dropdown>
            </div>
        </xpath>
    </t>
</templates>
