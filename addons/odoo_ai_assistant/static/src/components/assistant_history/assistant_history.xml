<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="odoo_ai_assistant.AssistantHistory">
        <section class="o_ai_assistant_history flex-grow-1 overflow-auto p-3" aria-label="Historial de chats">
            <button type="button"
                class="o_ai_assistant_history_item o_ai_assistant_history_item_new text-start border mb-3"
                t-att-disabled="isBusy" t-on-click="newConversation">
                <span class="o_ai_assistant_history_icon d-inline-flex align-items-center justify-content-center">
                    <i class="fa fa-plus" aria-hidden="true"/>
                </span>
                <span class="min-w-0 flex-grow-1">
                    <span class="d-block fw-semibold">Nuevo chat</span>
                    <span class="d-block small opacity-75">Inicia una conversación limpia</span>
                </span>
                <i class="fa fa-chevron-right opacity-50" aria-hidden="true"/>
            </button>

            <div class="o_ai_assistant_history_intro d-flex align-items-center justify-content-between gap-2 mb-2">
                <div class="d-flex align-items-center gap-2 min-w-0">
                    <CheckBox t-if="ui.selectionMode"
                        value="allVisibleSelected"
                        className="'d-flex m-0'"
                        onChange.bind="toggleAll"/>
                    <i t-else="" class="fa fa-history text-muted" aria-hidden="true"/>
                    <h3 class="h6 mb-0 text-truncate">
                        <t t-if="ui.selectionMode">
                            <t t-esc="selectedCount"/> seleccionados
                        </t>
                        <t t-else="">Chats recientes</t>
                    </h3>
                </div>
                <div class="o_ai_assistant_history_bulk d-flex align-items-center gap-1">
                    <Dropdown position="'bottom-end'" menuClass="'o_ai_assistant_history_action_menu'"
                        disabled="!ui.selectionMode or !selectedCount or isBusy">
                        <button type="button" class="btn btn-secondary btn-sm"
                            t-att-disabled="!ui.selectionMode or !selectedCount or isBusy">
                            Acciones masivas
                            <i class="fa fa-angle-down ms-1" aria-hidden="true"/>
                        </button>
                        <t t-set-slot="content">
                            <DropdownItem t-foreach="bulkActions" t-as="historyAction"
                                t-key="historyAction.id"
                                class="historyAction.danger ? 'text-danger' : ''"
                                onSelected="() => this.runBulkAction(historyAction)">
                                <i t-att-class="'fa ' + historyAction.icon + ' me-2'" aria-hidden="true"/>
                                <t t-esc="historyAction.label"/>
                            </DropdownItem>
                        </t>
                    </Dropdown>
                    <button t-if="ui.selectionMode" type="button"
                        class="btn btn-sm btn-link text-body px-1"
                        title="Cancelar selección" aria-label="Cancelar selección"
                        t-att-disabled="isBusy" t-on-click="exitSelection">
                        <i class="fa fa-times" aria-hidden="true"/>
                    </button>
                </div>
            </div>

            <div t-if="showSearch" class="o_ai_assistant_history_search mb-2">
                <i class="fa fa-search text-muted" aria-hidden="true"/>
                <input type="search" class="form-control form-control-sm"
                    maxlength="160" autocomplete="off"
                    placeholder="Buscar conversaciones…"
                    aria-label="Buscar conversaciones"
                    t-att-value="ui.search" t-on-input="onSearchInput"/>
            </div>

            <div class="o_ai_assistant_history_list d-flex flex-column gap-2">
                <div t-if="state.historyLoading" class="o_ai_assistant_history_loading text-center text-muted py-4">
                    <i class="fa fa-spinner fa-spin me-1" aria-hidden="true"/> Cargando conversaciones…
                </div>

                <div t-elif="!state.conversations.length" class="o_ai_assistant_history_empty text-center px-3 py-4">
                    <i class="fa fa-comments-o fa-2x text-muted mb-2" aria-hidden="true"/>
                    <div class="fw-semibold">Todavía no hay conversaciones</div>
                    <div class="small text-muted">El historial aparecerá aquí después de tu primer chat.</div>
                </div>

                <div t-elif="!conversations.length" class="o_ai_assistant_history_empty text-center px-3 py-4">
                    <i class="fa fa-search text-muted mb-2" aria-hidden="true"/>
                    <div class="fw-semibold">Sin coincidencias</div>
                    <div class="small text-muted">Prueba con otro término.</div>
                </div>

                <t t-else="">
                    <div t-foreach="conversations" t-as="conversation"
                        t-key="conversation.conversation_id"
                        t-att-class="'o_ai_assistant_history_item o_ai_assistant_history_item_chat border' + (conversation.conversation_id === state.conversationId ? ' o_ai_assistant_history_item_active' : '') + (isSelected(conversation.conversation_id) ? ' o_ai_assistant_history_item_selected' : '')">
                        <div t-if="ui.selectionMode" class="o_ai_assistant_history_selector d-flex align-items-center">
                            <CheckBox value="isSelected(conversation.conversation_id)"
                                className="'d-flex m-0'"
                                onChange="() => this.toggleSelected(conversation.conversation_id)"/>
                        </div>
                        <button type="button"
                            class="o_ai_assistant_history_item_open text-start border-0 min-w-0 flex-grow-1"
                            t-att-data-conversation-id="conversation.conversation_id"
                            t-att-disabled="isBusy" t-on-click="onConversationClick">
                            <span class="o_ai_assistant_history_icon d-inline-flex align-items-center justify-content-center">
                                <i class="fa fa-comment-o" aria-hidden="true"/>
                            </span>
                            <span class="min-w-0 flex-grow-1">
                                <span class="o_ai_assistant_history_title d-block fw-semibold text-truncate"
                                    t-esc="conversation.title"/>
                                <span class="d-block small text-muted">
                                    <t t-esc="formatUpdatedAt(conversation.updated_at)"/>
                                </span>
                            </span>
                        </button>
                        <Dropdown t-if="!ui.selectionMode" position="'bottom-end'"
                            menuClass="'o_ai_assistant_history_action_menu'" disabled="isBusy">
                            <button type="button"
                                class="btn btn-sm btn-link text-body o_ai_assistant_history_more"
                                aria-label="Acciones del chat" title="Acciones"
                                t-att-disabled="isBusy">
                                <i class="fa fa-ellipsis-v" aria-hidden="true"/>
                            </button>
                            <t t-set-slot="content">
                                <DropdownItem t-foreach="itemActions" t-as="historyAction"
                                    t-key="historyAction.id"
                                    class="historyAction.danger ? 'text-danger' : ''"
                                    onSelected="() => this.runItemAction(historyAction, conversation.conversation_id)">
                                    <i t-att-class="'fa ' + historyAction.icon + ' me-2'" aria-hidden="true"/>
                                    <t t-esc="historyAction.label"/>
                                </DropdownItem>
                            </t>
                        </Dropdown>
                    </div>
                </t>
            </div>
        </section>
    </t>

    <t t-name="odoo_ai_assistant.AssistantPanelHistoryUX"
        t-inherit="odoo_ai_assistant.AssistantPanel" t-inherit-mode="extension">
        <xpath expr="//button[@title='Nuevo chat']" position="attributes">
            <attribute name="t-if">state.runtimeState === 'authenticated' and !state.historyView</attribute>
            <attribute name="t-att-disabled">state.loading or state.historyLoading or state.decisionLoading or recoveryPending</attribute>
        </xpath>

        <xpath expr="//div[select[@aria-label='Historial de chats']]" position="replace">
            <div t-if="!ui.isMinimized and state.runtimeState === 'authenticated' and !state.historyView"
                class="o_ai_assistant_context_nav d-flex align-items-center">
                <button type="button"
                    class="btn btn-sm btn-link text-body o_ai_assistant_history_button px-1"
                    title="Volver al historial" aria-label="Volver al historial"
                    t-att-disabled="state.loading or state.historyLoading or state.decisionLoading or recoveryPending"
                    t-on-click="showHistory">
                    <i class="fa fa-arrow-left" aria-hidden="true"/>
                </button>
            </div>
        </xpath>

        <xpath expr="//div[contains(@class, 'o_ai_assistant_messages')]" position="before">
            <AssistantHistory t-if="!ui.isMinimized and state.runtimeState === 'authenticated' and state.historyView"/>
        </xpath>
        <xpath expr="//div[contains(@class, 'o_ai_assistant_messages')]" position="attributes">
            <attribute name="t-if">!ui.isMinimized and (!state.historyView or state.runtimeState !== 'authenticated')</attribute>
        </xpath>
        <xpath expr="//form[contains(@class, 'o_ai_assistant_composer')]" position="attributes">
            <attribute name="t-if">!ui.isMinimized and state.runtimeState === 'authenticated' and !state.historyView</attribute>
        </xpath>
    </t>
</templates>
