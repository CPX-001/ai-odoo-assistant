<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <record id="ir_cron_assistant_data_import" model="ir.cron">
        <field name="name">Odoo AI Assistant durable data import</field>
        <field name="model_id" ref="model_odoo_ai_data_import_session"/>
        <field name="state">code</field>
        <field name="code">model._cron_process_pending()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">minutes</field>
        <field name="active" eval="True"/>
    </record>

    <record id="ir_cron_assistant_data_import_cleanup" model="ir.cron">
        <field name="name">Odoo AI Assistant data import cleanup</field>
        <field name="model_id" ref="model_odoo_ai_data_import_session"/>
        <field name="state">code</field>
        <field name="code">model._cron_cleanup_terminal()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="active" eval="True"/>
    </record>
</odoo>
