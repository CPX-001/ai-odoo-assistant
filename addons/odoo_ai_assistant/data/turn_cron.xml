<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <record id="ir_cron_assistant_turn_slot_1" model="ir.cron">
        <field name="name">Odoo AI Assistant turn runner 1</field>
        <field name="model_id" ref="model_odoo_ai_turn"/>
        <field name="state">code</field>
        <field name="code">model._cron_run_turn_slot()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">minutes</field>
        <field name="active" eval="True"/>
    </record>
    <record id="ir_cron_assistant_turn_slot_2" model="ir.cron">
        <field name="name">Odoo AI Assistant turn runner 2</field>
        <field name="model_id" ref="model_odoo_ai_turn"/>
